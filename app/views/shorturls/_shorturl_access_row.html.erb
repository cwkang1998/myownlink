<% accessed_at = access.timestamp || access.created_at %>

<tr>
  <td class="whitespace-nowrap px-5 py-4">
    <% if accessed_at.present? %>
      <p class="font-medium text-slate-900"><%= accessed_at.strftime("%Y-%m-%d %H:%M:%S %Z") %></p>
      <p class="mt-1 text-xs text-slate-500"><%= time_ago_in_words(accessed_at) %> ago</p>
    <% else %>
      <p class="font-medium text-slate-900">Unknown</p>
    <% end %>
  </td>
  <td class="px-5 py-4">
    <span class="inline-flex rounded-md border border-slate-200 bg-slate-50 px-3 py-1 text-sm font-medium text-slate-700">
      <%= access.geolocation.presence || "Unknown" %>
    </span>
  </td>
</tr>
