<% content_for :title, @shorturl.title %>
<% content_for :page_title, @shorturl.title %>

<%
  short_url = full_short_url(@shorturl)
  shorturl_accesses = ShorturlAccess.where(shorturl_id: @shorturl.id).order(timestamp: :desc, created_at: :desc)
  visitor_count = shorturl_accesses.count
%>

<section class="w-full">
  <div class="mx-auto max-w-5xl">
    <header class="mb-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <h1 class="text-3xl font-semibold tracking-normal text-slate-900"><%= @shorturl.title %></h1>
        <%= render "shared/actionbar", text: "Back to Dashboard", navigate_to: root_path, variant: :secondary, wrapper_classes: "shrink-0" %>
      </div>
    </header>

    <div class="grid gap-6 rounded-lg border border-slate-200 bg-white p-6 shadow-sm md:grid-cols-[minmax(0,1fr)_14rem] md:items-center">
      <div class="space-y-5 text-left">
        <%= render "shared/copy_link", label: "Short URL", value: short_url, href: short_url %>
        <%= render "shared/copy_link", label: "Target URL", value: @shorturl.target_url, href: @shorturl.target_url %>
      </div>

      <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-6 text-center">
        <p class="text-sm font-medium text-emerald-700">Clicks</p>
        <p id="vistor_count" class="mt-2 text-5xl font-semibold text-slate-900"><%= visitor_count %></p>
      </div>
    </div>

    <div class="mt-8 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-5 py-4">
        <h2 class="text-lg font-semibold text-slate-900">Visits</h2>
      </div>

      <% if shorturl_accesses.present? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
            <thead class="bg-slate-50 text-slate-600">
              <tr>
                <th scope="col" class="px-5 py-3 font-medium">Timestamp</th>
                <th scope="col" class="px-5 py-3 font-medium">Geolocation</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <% shorturl_accesses.each do |access| %>
              
                <% accessed_at = access.timestamp || access.created_at %>
                <tr>
                  <td class="whitespace-nowrap px-5 py-4 text-slate-900">
                    <%= accessed_at&.strftime("%Y-%m-%d %H:%M:%S %Z") || "Unknown" %>
                  </td>
                  <td class="px-5 py-4 text-slate-900">
                    <%= access.geolocation.presence || "Unknown" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-5 py-12 text-center">
          <p class="text-base font-medium text-slate-900">No access records yet</p>
          <p class="mt-1 text-sm text-slate-500">Visitor details will appear after the short URL is opened.</p>
        </div>
      <% end %>
    </div>
  </div>
</section>
