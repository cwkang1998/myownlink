<% content_for :title, @shorturl.title %>

<%
  short_url = full_short_url(@shorturl)
%>

<section class="w-full">
  <div class="mx-auto max-w-5xl">
    <%= render "shared/actionbar",
      page_label: "Short URL Details",
      headline: @shorturl.title,
      description: "Created #{@shorturl.created_at.strftime("%Y-%m-%d")}",
      text: "Back to Dashboard",
      navigate_to: root_path,
      variant: :secondary %>

    <div class="grid gap-6 rounded-lg border border-slate-200 bg-white p-6 shadow-sm md:grid-cols-[minmax(0,1fr)_14rem] md:items-center">
      <div class="space-y-5 text-left">
        <%= render "shared/copy_link", label: "Short URL", value: short_url, href: short_url %>
        <%= render "shared/copy_link", label: "Target URL", value: @shorturl.target_url, href: @shorturl.target_url %>
      </div>

      <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-6 text-center">
        <p class="text-sm font-medium text-emerald-700">Clicks</p>
        <p id="visitor_count" class="mt-2 text-5xl font-semibold text-slate-900"><%= @visitor_count %></p>
      </div>
    </div>

    <div class="mt-8 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-5 py-4">
        <h2 class="text-lg font-semibold text-slate-900">Visits</h2>
        <p class="mt-1 text-sm text-slate-500">Recent access records for this short URL.</p>
      </div>

      <% if @shorturl_accesses.present? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
            <thead class="bg-slate-50 text-slate-600">
              <tr>
                <th scope="col" class="px-5 py-3 font-medium">Visit time</th>
                <th scope="col" class="px-5 py-3 font-medium">Location</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <% @shorturl_accesses.each do |access| %>
                <%= render "shorturls/shorturl_access_row", access: access %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-5 py-12 text-center">
          <p class="text-lg font-semibold text-slate-900">No visits yet</p>
          <p class="mt-2 text-sm text-slate-500">Share this short URL to start collecting click and location analytics.</p>
        </div>
      <% end %>

      <%= render "shared/pagination",
        current_page: @page,
        total_pages: @total_pages,
        page_size: @page_size,
        pages: @pagination_pages,
        path_for_page: ->(page_number) { shorturl_path(@shorturl, page: page_number, page_size: @page_size) } %>
    </div>
  </div>
</section>
