<% variant = local_assigns.fetch(:variant, :primary) %>
<% page_label = local_assigns[:page_label] %>
<% headline = local_assigns[:headline] %>
<% description = local_assigns[:description] %>
<%
  wrapper_classes = local_assigns.fetch(:wrapper_classes) do
    headline.present? ? "mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" : "mb-8 flex justify-end"
  end
%>

<% button_classes =
  case variant.to_sym
  when :secondary
    "inline-flex w-full items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:border-slate-900 hover:bg-slate-900 hover:text-white focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 sm:w-auto"
  else
    "inline-flex w-full items-center justify-center rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 sm:w-auto"
  end
%>


<div class="<%= wrapper_classes %>">
  <% if headline.present? %>
    <div class="max-w-2xl">
      <% if page_label.present? %>
        <p class="mb-2 text-sm font-semibold tracking-normal text-emerald-700"><%= page_label %></p>
      <% end %>
      <h1 class="text-3xl font-semibold tracking-normal text-slate-950 wrap-break-word"><%= headline %></h1>
      <% if description.present? %>
        <p class="mt-2 text-sm leading-6 text-slate-600"><%= description %></p>
      <% end %>
    </div>
  <% end %>

  <%= link_to navigate_to, class: button_classes do %>
    <% if variant.to_sym == :secondary %>
      <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M17 10a1 1 0 0 1-1 1H6.414l3.293 3.293a1 1 0 0 1-1.414 1.414l-5-5a1 1 0 0 1 0-1.414l5-5a1 1 0 1 1 1.414 1.414L6.414 9H16a1 1 0 0 1 1 1Z" clip-rule="evenodd" />
      </svg>
    <% end %>
    <span><%= text %></span>
  <% end %>
</div>
