<% if total_pages > 1 %>
  <div class="flex flex-col gap-3 border-t border-slate-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-slate-500">
      Page <%= current_page %> of <%= total_pages %> - <%= page_size %> per page
    </p>

    <nav class="flex items-center gap-2" aria-label="Pagination">
      <% pages.each do |page_number| %>
        <% if page_number == :gap %>
          <span class="inline-flex h-9 min-w-9 items-center justify-center px-2 text-sm font-medium text-slate-400" aria-hidden="true">...</span>
        <% elsif page_number == current_page %>
          <span aria-current="page" class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg bg-emerald-700 px-3 text-sm font-semibold text-white">
            <%= page_number %>
          </span>
        <% else %>
          <%= link_to page_number, path_for_page.call(page_number), class: "inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-slate-300 px-3 text-sm font-medium text-slate-700 hover:border-emerald-700 hover:bg-emerald-50 hover:text-emerald-800" %>
        <% end %>
      <% end %>
    </nav>
  </div>
<% end %>
